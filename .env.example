# Copie para .env e ajuste. Nunca versione o arquivo .env.
PORT=3000
NODE_ENV=development

# Autenticação (JWT). Em produção é obrigatório e fica no Key Vault.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Contas criadas na inicialização (gestor e robô não se cadastram pela API).
SEED_GESTOR_EMAIL=
SEED_GESTOR_SENHA=
SEED_ROBO_EMAIL=
SEED_ROBO_SENHA=

# Serviços das outras disciplinas. Sem URL, a API usa o plano B automaticamente.
GENAI_URL=
GENAI_API_KEY=
GENAI_TIMEOUT_MS=5000
VISAO_URL=
VISAO_API_KEY=
VISAO_TIMEOUT_MS=15000

# Banco de dados. Sem DATABASE_URL a API guarda tudo em memória (perde ao reiniciar).
# Local: postgres://postgres:postgres@localhost:5432/zelai
DATABASE_URL=
# true na Azure (conexão com TLS obrigatória)
DATABASE_SSL=false
